# Lägg riktiga nycklar i .env. Den filen ignoreras av Git.
SAMIDA_OLLAMA_BASE_URL=http://localhost:11434
SAMIDA_OLLAMA_CHAT_MODEL=gemma4:e4b
# För att köra mot Ollamas molnmodeller istället för en lokal instans (modellnamn
# utan "-cloud"-suffix - det används bara av den lokala Ollama-CLI:n, inte
# https://ollama.com/api direkt):
#   SAMIDA_OLLAMA_BASE_URL=https://ollama.com
#   SAMIDA_OLLAMA_CHAT_MODEL=gpt-oss:120b
#   SAMIDA_OLLAMA_VISION_MODEL=gemma4:31b
#   SAMIDA_OLLAMA_API_KEY=<din ollama.com API-nyckel>
SAMIDA_OLLAMA_API_KEY=
SAMIDA_REQUEST_TIMEOUT_SECONDS=120
SAMIDA_CAMOFOX_ENABLED=true
SAMIDA_CAMOFOX_BASE_URL=http://127.0.0.1:9377
# En egen SearxNG-instans (gratis, meta-sökning mot Google/Bing/Brave/DDG m.fl.),
# t.ex. via: docker run -d --name searxng --restart unless-stopped
#   -p 127.0.0.1:8888:8080 -v ~/services/searxng:/etc/searxng searxng/searxng
# Verktyget web_search fungerar med vilken chatt-modell som helst
# (Claude/OpenAI/Ollama) eftersom SAMIDA själv gör sökningen, inte providern.
SAMIDA_SEARXNG_BASE_URL=http://127.0.0.1:8888

# Måste peka på den publika URL:en appen nås på (inget avslutande /) - används
# för länken i callback-omdirigeringen (dit webbläsaren skickas EFTER att
# Google-inloggningen är klar).
SAMIDA_PUBLIC_BASE_URL=http://localhost:3000
# Google Calendar + Gmail (read-only) - kräver en OAuth-klient från
# https://console.cloud.google.com (APIs & Services > Credentials).
# /api/integrations/google/callback serveras av DENNA backend, inte av
# webbappen SAMIDA_PUBLIC_BASE_URL pekar på - i produktion är de samma
# ursprung bara för att Caddy reverse-proxar /api/* dit. Kör du frontend och
# backend på separata portar utan proxy (lokal utveckling, t.ex. web på :3000
# och backend på :8000) måste du sätta SAMIDA_GOOGLE_OAUTH_BASE_URL till
# backendens egna URL också, annars 404:ar Google-redirecten.
# Redirect URI att registrera i Google Cloud Console:
#   <SAMIDA_GOOGLE_OAUTH_BASE_URL eller SAMIDA_PUBLIC_BASE_URL>/api/integrations/google/callback
SAMIDA_GOOGLE_CLIENT_ID=
SAMIDA_GOOGLE_CLIENT_SECRET=
SAMIDA_GOOGLE_OAUTH_BASE_URL=

# E-postadressen för SAMIDAs ägare (dig). Bara det här kontot får välja de
# rikare profilerna (samida-standard/coding/jarvis/unreal) i chatten, eftersom
# de laddar memory/*.md - dina personliga anteckningar/projekt/tekniska
# uppsättning - som inte är uppdelade per användare. Andra konton begränsas
# tyst till "minimal".
SAMIDA_OWNER_EMAIL=

# Krävs för att kryptera användarnas lagrade API-nycklar. Generera en gång med:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Byt ALDRIG denna efter att den tagits i bruk i produktion - då går befintliga
# lagrade nycklar inte längre att dekryptera.
SAMIDA_SECRET_KEY=
# Sätt till false bara i lokal http-utveckling (inte i produktion bakom Caddy/HTTPS).
SAMIDA_COOKIE_SECURE=true

# Lägg den riktiga nyckeln i .env lokalt, aldrig i Git eller frontend.
OPENAI_API_KEY=
SAMIDA_OPENAI_MODEL=gpt-5.6-luna
