{
  "name": "samida-desktop",
  "version": "0.1.2",
  "private": true,
  "description": "SAMIDA Desktop - runs the assistant fully locally, no server or account needed.",
  "author": "Stefan Semb",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:backend": "powershell -ExecutionPolicy Bypass -File build-backend.ps1",
    "build:web": "powershell -ExecutionPolicy Bypass -File build-web.ps1",
    "dist": "npm run build:backend && npm run build:web && electron-builder",
    "publish": "npm run build:backend && npm run build:web && electron-builder --publish always"
  },
  "devDependencies": {
    "electron": "38.5.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@38.5.0": true
  },
  "build": {
    "appId": "dev.samida.desktop",
    "productName": "SAMIDA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron/**/*"
    ],
    "extraResources": [
      {
        "from": "build/backend/samida-backend",
        "to": "backend"
      },
      {
        "from": "build/content",
        "to": "content"
      },
      {
        "from": "build/web",
        "to": "web"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "stefansemb",
      "repo": "samida.dev",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
